# Port for the Node.js Express server
PORT=3000

# Environment mode (development / production)
NODE_ENV=development

# Session encryption secret (use a secure random string in production)
SESSION_SECRET=jomi-chinun-session-secret-competition-2026

# Demo mode: When true, forgot password returns the reset code in the API response
DEMO_MODE=true

# SQLite database file location
DATABASE_PATH=./data/jomi_chinun.db
